# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/database_name?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Bootstrap Administrator (Optional override)
ADMIN_EMAIL=admin@skillbridge.gov.in
ADMIN_PASSWORD=your_secure_bootstrap_admin_password_here

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here

# Gmail SMTP for Email Services
GMAIL_USER=your_email@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password
