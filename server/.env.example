# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://sih26044-ayush-portal.vercel.app
CORS_ORIGINS=https://sih26044-ayush-portal.vercel.app,http://localhost:5173,http://localhost:3000,https://sih26044-ayush-portal-server-4thq.vercel.app
BACKEND_URL=https://sih26044-ayush-portal-server-4thq.vercel.app

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/database_name?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Bootstrap Administrator (Optional override)
ADMIN_EMAIL=admin@nodalconnector.in
ADMIN_PASSWORD=your_secure_bootstrap_admin_password_here

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here

# Application Branding & Communication
APP_NAME=NodalConnector
SUPPORT_EMAIL=support@nodalconnector.in
EMAIL_FROM_ADDRESS=noreply@nodalconnector.in

# Gmail SMTP for Email Services
# NOTE: Gmail App Password must be entered WITHOUT spaces (16 consecutive letters)
GMAIL_USER=your_email@example.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password_without_spaces

# Or Custom SMTP (Alternative to Gmail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
