# =================================================================
# Client Environment Configuration (Vite + React)
# =================================================================

# Backend API endpoint URL (Express REST API)
# In development: http://localhost:5000/api
# In production: https://api.yourdomain.com/api or https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Backend Base URL (for Socket.IO real-time video signaling & WebSockets)
# In development: http://localhost:5000
# In production: https://api.yourdomain.com or https://your-backend.onrender.com
VITE_BACKEND_URL=http://localhost:5000
